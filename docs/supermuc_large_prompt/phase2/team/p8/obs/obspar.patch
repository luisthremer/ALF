+  !> Work-item index bit reversal (nb bits)
+  Integer Function pq_brev(j, nb)
+    Implicit none
+    !$omp declare target
+    Integer, intent(in) :: j, nb
+    Integer :: b
+    pq_brev = 0
+    do b = 0, nb-1
+       pq_brev = ior(ishft(pq_brev,1), iand(ishft(j,-b),1))
+    enddo
+  end function pq_brev
+
+  !> Pairwise sum of the PNP partial values pq(m+1, 0:PNP-1, w) in the order of the halving tree over the index tp (strides PNP/2 ... 1):
+  !> the leaves are taken in bit-reversed order and merged like a binary counter, which gives (x(tp) + x(tp+s)) at every level.
+  Complex (Kind=Kind(0.d0)) Function pq_tree(pqa, M0, m, w)
+    Implicit none
+    !$omp declare target
+    Integer, intent(in) :: M0, m, w
+    Complex (Kind=Kind(0.d0)), intent(in) :: pqa(M0,0:PNP-1,5)
+    Complex (Kind=Kind(0.d0)) :: st(0:10), v
+    Integer :: jj, c, lv
+    st = (0.d0, 0.d0)
+    do jj = 0, PNP-1
+       v = pqa(m+1, pq_brev(jj,PQB), w)
+       c = jj; lv = 0
+       do while (iand(c,1) == 1)
+          v = st(lv) + v; c = ishft(c,-1); lv = lv + 1
+       enddo
+       st(lv) = v
+    enddo
+    pq_tree = st(PQB)
+  end function pq_tree
+
+  !> Correlations of all kinds with the same results as the loop over corr(), bit for bit (N <= 1024); see the module header.
+  !> The old kernel per output m: `parallel do reduction(+:s)` over I = 1..N.  Its value is the halving tree over the work-item index t = I-1
+  !> (zero padded to 1024): A_1024(t) = leaf_t, A_s(t) = A_2s(t) + A_2s(t+s), result A_1(0).  Split at stride PNP: the PNP partial trees
+  !> over the leaves t = tp + PNP*kk (kk = 0..PNK-1, halving over kk) are stage 1 (one work-item per (tp, output), outputs on consecutive
+  !> lanes), the tree over tp is stage 2 (one work-item per output).  Each leaf is formed as gpu_obs_zq + term (gpu_obs_zq is a runtime zero), the
+  !> code shape of the old `s1 = s1 + term` with the reduction identity; leaves t >= N are +0.  Parallel here: Green, SpinMz (three sums) or SpinSUN.
+  !> The extra work-items of stage 1 evaluate the terms of the serial acc0 sums (zdn, zsp), the extra ones of stage 2 do those sums (order
+  !> I = 1..N as before, in chunks of PCH loads).  The Den correlation (the one kind whose compiled leaf differed from the old kernel in the last bit
+  !> for some entries when written as above, measured) keeps the old kernel: corr(kd, 3, ...) with its serial acc0 kernel skipped (o_skip_acc0).
+  !> Bitwise: Green (additions only, so independent of how the compiler fuses), Den (old kernel), the acc0 sums and the SpinMz / SpinSUN sums
+  !> (same expressions; compiler dependent in principle, equal to the old kernels in every gate run).
+  Subroutine corr_par(ZW, N, Norb, NFL, NSUN, sq3)
+    Implicit none
+    Integer, intent(in) :: N, Norb, NFL, NSUN
+    Complex (Kind=Kind(0.d0)), intent(in) :: ZW
+    Real (Kind=Kind(0.d0)), intent(in) :: sq3
+    Integer :: k, kg, kd, ks, ku, M0, NL, lin, tp, m, imj, no, no2, I, Ic, J, i1, j1, nf, kk, lev, sst, d, I0, c
+    Logical :: fd, fs, fu
+    Complex (Kind=Kind(0.d0)) :: sg, s1, s2, s3, zg, zi, a, b, gA, gB, zxy, zz, zj, zq_, zs0
+    Complex (Kind=Kind(0.d0)) :: x1(0:PNK-1), x3(0:PNK-1), x4(0:PNK-1), x5(0:PNK-1), zb(0:PCH-1), t1
+    Real (Kind=Kind(0.d0)) :: ns, wr, wi
+
+    ns = dble(NSUN); wr = real(ZW); wi = aimag(ZW)
+    kg = 0; kd = 0; ks = 0; ku = 0
+    do k = 1, o_nobs
+       select case (o_kind(k))
+       case (1); kg = k
+       case (2); ku = k
+       case (3); kd = k
+       case (4); if (k == 2 .and. o_NSUN == 1) ks = k      ! SpinMz: k = 2 fills Obs_eq(2:4); host measures only N_SUN = 1
+       end select
+    enddo
+    fd = (kd > 0); fs = (ks > 0); fu = (ku > 0)
+    M0 = N*Norb*Norb; NL = PNP*M0; zq_ = gpu_obs_zq
+    ! ---- stage 1
+    !$omp target teams distribute parallel do private(m,imj,no,no2,I,Ic,J,i1,j1,nf,tp,kk,lev,sst,d,sg,s1,s2,s3,zg,zi,zj,a,b,gA,gB,zxy,zz,x1,x3,x4,x5)
+    do lin = 0, NL + N*Norb - 1
+       if (lin < NL) then
+          tp = lin / M0; m = lin - tp*M0
+          imj = mod(m,N) + 1; no = mod(m/N,Norb) + 1; no2 = m/(N*Norb) + 1
+          do kk = 0, PNK-1
+             I = tp + PNP*kk + 1; Ic = min(I,N)
+             J = o_jct(imj,Ic); i1 = o_inv(Ic,no); j1 = o_inv(J,no2)
+             zg = (0.d0, 0.d0)                                   ! Green
+             do nf = 1, NFL
+                a = -G_d(j1,i1,nf); if (i1 == j1) a = a + (1.d0, 0.d0)
+                zg = zg + a
+             enddo
+             sg = zq_; sg = sg + zg*ns
+             if (I > N) sg = (0.d0, 0.d0)
+             x1(kk) = sg
+             if (fs) then                                        ! SpinMz (N_FL = 2, N_SUN = 1)
+                a = -G_d(j1,i1,1); if (i1 == j1) a = a + (1.d0, 0.d0)
+                b = -G_d(j1,i1,2); if (i1 == j1) b = b + (1.d0, 0.d0)
+                gA = G_d(i1,j1,1); gB = G_d(i1,j1,2)
+                zxy = a*gB + b*gA
+                zi = ((1.d0, 0.d0) - G_d(i1,i1,2)) - ((1.d0, 0.d0) - G_d(i1,i1,1))
+                zj = ((1.d0, 0.d0) - G_d(j1,j1,2)) - ((1.d0, 0.d0) - G_d(j1,j1,1))
+                zz = a*gA + b*gB + zi*zj
+                s1 = zq_; s2 = zq_; s3 = zq_
+                s1 = s1 + zz
+                s2 = s2 + zxy
+                s3 = s3 + (2.d0*zxy + zz)/3.d0
+                if (I > N) then; s1 = (0.d0, 0.d0); s2 = (0.d0, 0.d0); s3 = (0.d0, 0.d0); endif
+                x3(kk) = s1; x4(kk) = s2; x5(kk) = s3
+             elseif (fu) then                                    ! SpinSUN (N_FL = 1)
+                a = -G_d(j1,i1,1); if (i1 == j1) a = a + (1.d0, 0.d0)
+                s1 = zq_; s1 = s1 + a*G_d(i1,j1,1)*ns
+                if (I > N) s1 = (0.d0, 0.d0)
+                x3(kk) = s1
+             endif
+          enddo
+          do lev = PNBK-1, 0, -1                                 ! halving tree over kk
+             sst = ishft(1,lev)
+             do kk = 0, sst-1
+                x1(kk) = x1(kk) + x1(kk+sst)
+                if (fs .or. fu) x3(kk) = x3(kk) + x3(kk+sst)
+                if (fs) then; x4(kk) = x4(kk) + x4(kk+sst); x5(kk) = x5(kk) + x5(kk+sst); endif
+             enddo
+          enddo
+          pq(m+1,tp,1) = x1(0)
+          if (fs .or. fu) pq(m+1,tp,3) = x3(0)
+          if (fs) then; pq(m+1,tp,4) = x4(0); pq(m+1,tp,5) = x5(0); endif
+       else                                                      ! terms of the serial acc0 sums
+          d = lin - NL; no = d / N + 1; I = d - (no-1)*N + 1
+          i1 = o_inv(I,no)
+          if (fd) then
+             zi = (0.d0, 0.d0)
+             do nf = 1, NFL
+                zi = zi + ((1.d0, 0.d0) - G_d(i1,i1,nf))
+             enddo
+             zdn(I,no) = zi
+          endif
+          if (fs) zsp(I,no) = ((1.d0, 0.d0) - G_d(i1,i1,2)) - ((1.d0, 0.d0) - G_d(i1,i1,1))
+       endif
+    enddo
+    ! ---- stage 2
+    !$omp target teams distribute parallel do private(m,imj,no,no2,d,I,I0,c,zs0,zb,t1)
+    do lin = 0, M0 + 2*Norb - 1
+       if (lin < M0) then
+          m = lin
+          imj = mod(m,N) + 1; no = mod(m/N,Norb) + 1; no2 = m/(N*Norb) + 1
+          t1 = pq_tree(pq, M0, m, 1)
+          acc(imj,1,no,no2,kg) = acc(imj,1,no,no2,kg) + t1*cmplx(wr,wi,kind(0.d0))
+          if (fu) then
+             t1 = pq_tree(pq, M0, m, 3)
+             acc(imj,1,no,no2,ku) = acc(imj,1,no,no2,ku) + t1*cmplx(wr,wi,kind(0.d0))
+          endif
+          if (fs) then
+             t1 = pq_tree(pq, M0, m, 3)
+             acc(imj,1,no,no2,ks) = acc(imj,1,no,no2,ks) + t1*cmplx(wr,wi,kind(0.d0))
+             t1 = pq_tree(pq, M0, m, 4)
+             acc(imj,1,no,no2,ks+1) = acc(imj,1,no,no2,ks+1) + t1*cmplx(wr,wi,kind(0.d0))
+             t1 = pq_tree(pq, M0, m, 5)
+             acc(imj,1,no,no2,ks+2) = acc(imj,1,no,no2,ks+2) + t1*cmplx(wr,wi,kind(0.d0))
+          endif
+       else
+          d = lin - M0
+          if (d < Norb) then                                     ! Den: acc0 = sum_I zi(I)*ns, I = 1..N in order
+             no = d + 1
+             if (fd) then
+                zs0 = (0.d0, 0.d0)
+                do I0 = 1, N, PCH
+                   do c = 0, PCH-1
+                      zb(c) = zdn(min(I0+c,N),no)
+                   enddo
+                   do c = 0, PCH-1
+                      if (I0+c <= N) zs0 = zs0 + zb(c)*ns
+                   enddo
+                enddo
+                acc0(no,kd) = acc0(no,kd) + zs0*cmplx(wr,wi,kind(0.d0))
+             endif
+          else                                                   ! SpinMz: acc0
+             no = d - Norb + 1
+             if (fs) then
+                zs0 = (0.d0, 0.d0)
+                do I0 = 1, N, PCH
+                   do c = 0, PCH-1
+                      zb(c) = zsp(min(I0+c,N),no)
+                   enddo
+                   do c = 0, PCH-1
+                      if (I0+c <= N) zs0 = zs0 + zb(c)
+                   enddo
+                enddo
+                acc0(no,ks)   = acc0(no,ks)   + zs0*cmplx(wr,wi,kind(0.d0))
+                acc0(no,ks+2) = acc0(no,ks+2) + zs0*cmplx(wr,wi,kind(0.d0))/sq3
+             endif
+          endif
+       endif
+    enddo
+    if (fd) then          ! Den: the old kernel, without its serial acc0 kernel (done above)
+       o_skip_acc0 = .true.
+       call corr(kd, 3, ZW, N, Norb, NFL, NSUN, sq3)
+       o_skip_acc0 = .false.
+    endif
+    if (o_plant) then          ! debug only (ALF_GPU_OBSPAR_PLANT=1, needs ALF_GPU_DEBUG=1): one Green output x (1+1e-12) in a separate kernel; the bitwise gate must fail
+       !$omp target
+       acc(2,1,1,1,kg) = acc(2,1,1,1,kg)*(1.d0 + 1.d-12)
+       !$omp end target
+    endif
+  End Subroutine corr_par
