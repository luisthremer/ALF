+/* ALF: HIP kernels run on their own stream; the application registers a function that waits for them. It is called
+   before every launch of an OpenMP kernel and before every copy/free of device memory, so that the HIP wrappers do not
+   have to synchronise after every launch.  */
+static int (*alf_presync_fn) (void) = NULL;
+void
+alf_gcn_set_presync (int (*f) (void))
+{
+  alf_presync_fn = f;
+}
+#define ALF_PRESYNC() do { if (alf_presync_fn) alf_presync_fn (); } while (0)
