+/* ALF-AMD local patch: pool kernarg blocks and completion signals so that a
+   kernel launch does not hit the HSA allocator/driver every time.  */
+#define ALF_POOL_MAX 256
+static pthread_mutex_t alf_pool_lock = PTHREAD_MUTEX_INITIALIZER;
+static void *alf_kernarg_pool[ALF_POOL_MAX];
+static int alf_kernarg_n = 0;
+static uint64_t alf_signal_pool[ALF_POOL_MAX];
+static int alf_signal_n = 0;
+
+/* ALF-AMD local patch: optional per-kernel wall-time profile (GCN_PROF=1).  */
+#include <time.h>
+#define ALF_PROF_MAX 512
+static struct { const char *name; double t; long n; } alf_prof[ALF_PROF_MAX];
+static int alf_prof_n = 0;
+static int alf_prof_on = -1;
+static pthread_mutex_t alf_prof_lock = PTHREAD_MUTEX_INITIALIZER;
+static double alf_now (void)
+{ struct timespec ts; clock_gettime (CLOCK_MONOTONIC, &ts); return ts.tv_sec + 1e-9 * ts.tv_nsec; }
+static void alf_prof_add (const char *name, double dt)
+{
+  pthread_mutex_lock (&alf_prof_lock);
+  int i;
+  for (i = 0; i < alf_prof_n; i++) if (alf_prof[i].name == name) break;
+  if (i == alf_prof_n && i < ALF_PROF_MAX) { alf_prof[i].name = name; alf_prof_n++; }
+  if (i < ALF_PROF_MAX) { alf_prof[i].t += dt; alf_prof[i].n++; }
+  pthread_mutex_unlock (&alf_prof_lock);
+}
+static void __attribute__((destructor)) alf_prof_dump (void)
+{
+  if (alf_prof_on != 1) return;
+  double tot = 0;
+  for (int i = 0; i < alf_prof_n; i++) tot += alf_prof[i].t;
+  fprintf (stderr, "GCN_PROF total kernel wall %.3f s\n", tot);
+  for (int i = 0; i < alf_prof_n; i++)
+    fprintf (stderr, "GCN_PROF %10.3f s %9ld calls %8.1f us/call  %s\n", alf_prof[i].t, alf_prof[i].n, 1e6 * alf_prof[i].t / alf_prof[i].n, alf_prof[i].name);
+}
