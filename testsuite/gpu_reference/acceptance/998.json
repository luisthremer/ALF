   "build": "nv_none_log",
   "config": "hub6x6_cb_fd",
   "seeds": "acc1"
  },
  "c2_gpu": {
   "build": "nv_log",
   "config": "hub6x6_cb_c2",
   "seeds": "acc1"
  },
  "c2_cpu": {
   "build": "nv_none_log",
   "config": "hub6x6_cb_c2",
   "seeds": "acc2"
  },
  "ss_log_m": {
   "build": "nv_log",
   "config": "hub6x6_cb_fd"
  },
  "rp_log_m": {
   "build": "nv_log",
   "config": "hub6x6_cb_fd"
  },
  "pd_log_m": {
   "build": "nv_log",
   "config": "hub6x6_cb_fd",
   "seeds": "acc1",
   "env": [
    "ALF_GPU_TAUDIAG=2",
    "ALF_GPU_TAUDIAG_FROM=101"
   ],
   "allow_debug": true
  },
  "c2_gpu_m": {
   "build": "nv_log",
   "config": "hub6x6_cb_c2",
   "seeds": "acc1"
  },
  "pd_ns0": {
   "build": "nv_log",
   "config": "hub6x6_cb_fd",
   "seeds": "acc1",
   "env": [
    "ALF_GPU_NS=0"
   ],
   "allow_debug": true
  }
 },
 "mutations": [
  {
   "src": "ss_log",
   "dst": "ss_log_m",
   "kind": "scale:Green_tau/obser:1e-3"
  },
  {
   "src": "rp_log",
   "dst": "rp_log_m",
   "kind": "scale:Den_eq/obser:1e-12"
  },
  {
   "src": "pd_log",
   "dst": "pd_log_m",
   "kind": "taudiag_bias:1.5"
  },
  {
   "src": "c2_gpu",
   "dst": "c2_gpu_m",
   "kind": "shift:Ener_scal/obser:8"
  }
 ],
 "ctests": [
  {
   "id": "gnu_ctest",
   "tool": "gnu",
   "configure": "GNU devel noMPI",
   "regex": "^t_"
  }
 ],
 "log_mutations": [
  {
   "src": "gnu_ctest",
   "dst": "gnu_ctest_m",
   "file": "ctest.log",
   "kind": "ctest_one_failure",
   "exit_file": "ctest.exit"
  }
 ],
 "gates": [
  {
   "id": "selftest",
   "type": "selftest",
   "runs": [
    "st_log"
   ],
   "require_lines": [
    "GPU tau self-test PASSED"
   ],
   "number_checks": [
    {
     "name": "pass",
     "line": "^\\s+G00\\s+\\S+ \\(worst slice",
     "after": "^",
     "max": 1e-10,
     "min_count": 4
    }
   ]
  },
  {
   "id": "faults",
   "type": "faults",
   "cases": {
    "fault_log_prop": "tau: pass"
   }
  },
  {
   "id": "same_seed",
   "type": "same_seed",
   "pairs": [
    [
     "ss_log",
     "ss_cpu",
     200
    ]
   ],
   "n_datasets": 38,
   "n_tau_datasets": 5,
   "no_bin_above": 0.0001,
   "overall_max": 1e-09,
   "tau_max": 1e-09
  },
  {
   "id": "non_interference",
   "type": "replay",
   "datasets": "equal_time",
   "pairs": [
    [
     "ni_base",
     "ss_log"
    ]
   ],
   "n_datasets": 23
  },
  {
   "id": "replay",
   "type": "replay",
   "pairs": [
    [
     "ss_log",
     "rp_log"
    ]
   ],
   "n_datasets": 38
  },
  {
   "id": "paired",
   "type": "paired",
   "runs": [
    "pd_log"
   ],
   "from_pass": 101,
   "n_points": 1600,
   "n_used": 800,
   "abs_mean_max": 0.05,
   "sd_ratio_max": 1.25,
   "count_thresholds": [
    1e-09
   ],
   "count_k": 2.0,
   "count_min_events": 10
  },
  {
   "id": "precision",
   "type": "precision",
   "mean_ratio_max": 1.5,
   "cases": [
    {
     "gpu": "pd_log",
     "cpu": [
      "pc_cpu"
     ]
    }
   ]
  },
  {
   "id": "compare2",
   "type": "compare2",
   "a": "c2_gpu",
   "b": "c2_cpu",
   "m": 10,
   "alpha": 0.01,
   "min_bins": 8
  },
  {
   "id": "ctest",
   "type": "log_regex",
   "checks": [
    {
     "file": "gnu_ctest/ctest.log",
     "stamp_file": "gnu_ctest/stamp",
     "exit_file": "gnu_ctest/ctest.exit",
     "regex": "(\\d+)% tests passed, (\\d+) tests failed out of (\\d+)",
     "equals": [
      100,
      0,
      13
     ]
    }
   ]
  },
  {
   "id": "gpu_none_ppcmp",
   "type": "log_regex",
   "checks": [
    {
     "file": "gpunone/ppcmp.txt",
     "stamp_file": "gpunone/stamp",
     "exit_file": "gpunone/ppcmp.exit",
     "stamp_contains": [
      "plant no"
     ],
     "regex": "comparisons (\\d+) preprocessor_errors (\\d+) differing_lines (\\d+) added_or_deleted (\\d+) build_files (\\d+) other_files (\\d+)$",
     "equals": [
      27,
      0,
      0,
      0,
      1,
      0
     ]
    }
   ]
  }
 ],
 "controls": [
