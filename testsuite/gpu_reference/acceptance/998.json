  }
 },
 "configs": {
  "hub6x6_cb": {
   "base": "hub6x6_cb"
  },
  "hub6x6_cb_fd": {
   "base": "hub6x6_cb",
   "overrides": {
    "NSweep": 1,
    "NBin": 200
   }
  },
  "hub6x6_cb_c2": {
   "base": "hub6x6_cb",
   "overrides": {
    "NSweep": 5,
    "NBin": 40
   }
  }
 },
 "runs": {
  "st_log": {
   "build": "nv_log",
   "config": "hub6x6_cb",
   "env": [
    "ALF_GPU_SELFTEST=4",
    "ALF_GPU_EXIT=1"
   ],
