    "ALF_GPU_EXIT=1",
    "ALF_GPU_FAULT_TAU=prop"
   ],
   "allow_debug": true
  },
  "ss_log": {
   "build": "nv_log",
   "config": "hub6x6_cb_fd"
  },
  "ss_cpu": {
   "build": "nv_none_log",
   "config": "hub6x6_cb_fd",
   "refcache": true
  },
  "ni_base": {
   "build": "base_nv_log",
   "config": "hub6x6_cb_fd"
  },
  "rp_log": {
   "build": "nv_log",
   "config": "hub6x6_cb_fd"
  },
  "pd_log": {
   "build": "nv_log",
   "config": "hub6x6_cb_fd",
