  "GPU tau pass (207): ACTIVE"
 ],
 "builds": {
  "nv_log": {
   "tool": "nvhpc",
   "configure": "PGI noMPI HDF5 LOG GPU=nvidia",
   "gpu": true
  },
  "nv_none_log": {
   "tool": "nvhpc",
   "configure": "PGI noMPI HDF5 LOG",
