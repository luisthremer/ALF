#!/bin/bash
# Test shim for squeue -h -o %j: prints the job names listed in $SHIM_STATE/queue (simulated pending jobs).
# SHIM_SQUEUE_FAIL=1 simulates a failing squeue (controller unreachable): message on stderr, exit 1.
if [ "${SHIM_SQUEUE_FAIL:-0}" = 1 ]; then
    echo "squeue: error: Unable to contact slurm controller (connect failure) (shim)" >&2
    exit 1
fi
[ -r "${SHIM_STATE:-/nonexistent}/queue" ] && cat "$SHIM_STATE/queue"
exit 0
